# Copia este fichero a .env y rellena los valores. .env nunca se sube al repo.

# --- Supabase (proyecto uwgqxdfpkkbenmynwlmk) ---
# URL y claves publicas: Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://uwgqxdfpkkbenmynwlmk.supabase.co
SUPABASE_ANON_KEY=
# service_role: secreta, solo la usa el backend. Nunca va al frontend.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica del frontend: CORS del backend y redirect_to de las invitaciones
# y la recuperacion de contrasena.
FRONTEND_URL=http://localhost:4200

# --- Autenticacion de servicio backend -> agentes (change
# autenticacion-backend-agentes): credencial compartida que el backend envia
# en la cabecera X-Agent-Service-Token en toda llamada A2A, y que los 5
# agentes (code/evaluator/exercises/reviewer/web) verifican antes de
# ejecutar cualquier logica de negocio. Genera un valor con:
#   openssl rand -hex 32
AGENT_SERVICE_TOKEN=

# --- LiteLLM (paso 2 en adelante: los agentes de generacion y valoracion) ---
# Clave de administracion del proxy (propuesta litellm-virtual-keys): ya NO
# la usa ningun agente para sus llamadas de negocio (cada uno tiene su propia
# virtual key, mas abajo); solo autentica infra/litellm/provision_keys.py y
# cualquier gestion manual via /key/*. Ya NO sirve como contraseña de la UI
# de LiteLLM (propuesta litellm-admin-ui-credentials, ver mas abajo). Genera
# una con:
#   openssl rand -hex 32
# y antepon "sk-", p. ej. LITELLM_MASTER_KEY=sk-<lo que salga>.
LITELLM_MASTER_KEY=

# Credenciales propias de la UI de administracion de LiteLLM (/ui), propuesta
# litellm-admin-ui-credentials: el puerto 4000 ya esta publicado al host, asi
# que sin esto el login aceptaria LITELLM_MASTER_KEY como contraseña.
# Genera la contraseña con:
#   openssl rand -hex 32
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=

# Postgres dedicado al control-plane de LiteLLM (virtual keys, budgets):
# propio, no el de Supabase. Genera la password con:
#   openssl rand -hex 32
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=
LITELLM_DB_NAME=litellm

# Identificador de modelo que entienda LiteLLM, p. ej. "anthropic/claude-sonnet-4-5".
GENERATOR_MODEL=
GENERATOR_API_KEY=
EVALUATOR_MODEL=
EVALUATOR_API_KEY=
REVIEWER_MODEL=
REVIEWER_API_KEY=

# Virtual keys por agente (propuesta litellm-virtual-keys): cada agente
# autentica contra LiteLLM con su propia credencial, restringida al modelo
# logico que necesita (web/code/exercises -> generator; evaluator ->
# evaluator; reviewer -> reviewer). Se generan ejecutando, con el proxy ya
# levantado y LITELLM_MASTER_KEY en el entorno:
#   python infra/litellm/provision_keys.py
# y pegando aqui el valor de cada linea que imprime.
AGENT_WEB_LITELLM_KEY=
AGENT_CODE_LITELLM_KEY=
AGENT_EXERCISES_LITELLM_KEY=
AGENT_EVALUATOR_LITELLM_KEY=
AGENT_REVIEWER_LITELLM_KEY=

# Guardrail de deteccion de prompt injection en el proxy (propuesta
# litellm-lakera-guardrail): corre automaticamente en toda llamada de los
# 5 agentes (default_on, antes de llegar al proveedor). Cuenta, proyecto y
# politica se gestionan en la plataforma de Lakera, no en este repo; aqui
# solo hace falta la API key (App Access -> + Create new API key).
LAKERA_API_KEY=

# --- Tavily (paso 2: herramienta del agente web) ---
TAVILY_API_KEY=

# --- Postgres directo (paso 2: memoria de los agentes de generacion) ---
# Conexion nativa a la base de datos de Supabase, NO la API REST/service_role:
# langgraph-checkpoint-postgres (PostgresSaver/PostgresStore) la exige.
# Host/puerto/nombre de BD: Supabase dashboard -> Project Settings -> Database
# -> Connection parameters (usar el host de "Session pooler" o conexion directa,
# puerto tal cual lo de ahi, nombre de BD normalmente "postgres").
AGENTS_PG_HOST=
AGENTS_PG_PORT=
AGENTS_PG_DATABASE=postgres
# Contrasenas de los roles creados por la migracion 0003_agents_memory.sql.
# Generalas tu (p. ej. openssl rand -hex 32) ANTES de aplicar esa migracion:
# son las que sustituyen a los placeholders __AGENTS_MEMORY_PASSWORD__ y
# __AGENTS_EXERCISE_READER_PASSWORD__ del fichero SQL en el momento de aplicarla.
AGENTS_MEMORY_PASSWORD=
AGENTS_EXERCISE_READER_PASSWORD=
# El pooler de Supabase (Supavisor) exige que el usuario de conexion lleve
# el project ref como sufijo (agents_memory.<ref>, no agents_memory a secas).
# Es el mismo ref que aparece en SUPABASE_URL (la parte antes de ".supabase.co").
SUPABASE_PROJECT_REF=uwgqxdfpkkbenmynwlmk

# --- Langfuse Cloud (paso 2 en adelante: trazas de generacion y valoracion) ---
# Dos variables con la misma URL porque hay dos consumidores con nombres
# distintos: LiteLLM (litellm_settings.success/failure_callback) lee
# LANGFUSE_HOST; el SDK de Langfuse v3, que usaran los servicios de agentes
# en Python para encadenar sus propias trazas, lee LANGFUSE_BASE_URL.
# Ajusta la URL a la region que te haya asignado Langfuse Cloud al crear el
# proyecto (puede no ser la US por defecto, hay tambien instancia EU).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- GitHub App (change acceso-repo-github-tool: acceso de solo lectura a
# repos de GitHub, publicos o corporativos privados, sin clonar ni
# almacenar nada en disco) ---
# Crea la App en https://github.com/settings/apps (o la de tu organizacion),
# con el unico permiso "Repository contents: Read-only", e instalala solo en
# los repos que de verdad necesites. El ID de la App esta en su pagina de
# ajustes.
GITHUB_APP_ID=
# Clave privada (.pem) generada al crear la App, pegada aqui con los saltos
# de linea escapados como \n (una sola linea), p. ej.:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----\n"
# Nunca en texto plano en el repo real: solo en tu .env local / el gestor de
# secretos del entorno de despliegue. La instalacion a usar para cada
# owner/repo se resuelve en tiempo de llamada (GET
# /repos/{owner}/{repo}/installation), no hace falta fijar un ID aqui.
GITHUB_APP_PRIVATE_KEY=
