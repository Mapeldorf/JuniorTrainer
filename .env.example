# Copia este fichero a .env y rellena los valores. .env nunca se sube al repo.

# --- Supabase (proyecto uwgqxdfpkkbenmynwlmk) ---
# URL y claves publicas: Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://uwgqxdfpkkbenmynwlmk.supabase.co
SUPABASE_ANON_KEY=
# service_role: secreta, solo la usa el backend. Nunca va al frontend.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica del frontend: CORS del backend y redirect_to de las invitaciones
# y la recuperacion de contrasena.
FRONTEND_URL=http://localhost:4200

# --- LiteLLM (paso 2 en adelante: los agentes de generacion y valoracion) ---
# Clave que exige el propio proxy de LiteLLM para arrancar (si no, rechaza
# iniciar: cualquiera podria llamarlo sin autenticacion). Genera una con:
#   openssl rand -hex 32
# y antepon "sk-", p. ej. LITELLM_MASTER_KEY=sk-<lo que salga>.
LITELLM_MASTER_KEY=

# Identificador de modelo que entienda LiteLLM, p. ej. "anthropic/claude-sonnet-4-5".
GENERATOR_MODEL=
GENERATOR_API_KEY=
EVALUATOR_MODEL=
EVALUATOR_API_KEY=
REVIEWER_MODEL=
REVIEWER_API_KEY=

# --- Tavily (paso 2: herramienta del agente web) ---
TAVILY_API_KEY=

# --- Langfuse Cloud (paso 2 en adelante: trazas de generacion y valoracion) ---
# Dos variables con la misma URL porque hay dos consumidores con nombres
# distintos: LiteLLM (litellm_settings.success/failure_callback) lee
# LANGFUSE_HOST; el SDK de Langfuse v3, que usaran los servicios de agentes
# en Python para encadenar sus propias trazas, lee LANGFUSE_BASE_URL.
# Ajusta la URL a la region que te haya asignado Langfuse Cloud al crear el
# proyecto (puede no ser la US por defecto, hay tambien instancia EU).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
